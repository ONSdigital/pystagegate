{
    "prov_fin": {
        "root_path": "tests/data/prov_fin/",
        "output_path": "tests/data/output/",
        "global_parameters": {
            "age_min": 0,
            "age_max": 200,
            "year": 2024,
            "final_nationalities": ["All Nationalities", "British", "Non-British"],
            "provisional_scot_direction": ["in", "out"]
        },
        "datasets": {
            "final_immigration": {
                "path": "final_immigration.csv",
                "variables": {
                    "la_code": "Local Authority Code",
                    "age": "Age",
                    "sex": "Sex",
                    "nationality": "Nationality Group",
                    "year": "Year",
                    "count": "Count"
                }
            },
            "final_emigration": {
                "path": "final_emigration.csv",
                "variables": {
                    "la_code": "Local Authority Code",
                    "age": "Age",
                    "sex": "Sex",
                    "nationality": "Nationality Group",
                    "year": "Year",
                    "count": "Count"
                }
            },
            "provisional": {
                "path": "provisional.csv",
                "variables": {
                    "la_code": "code",
                    "age": "Age",
                    "sex": "sex",
                    "immigration": "international_in_2024",
                    "emigration": "international_out_2024",
                    "net": "international_net_2024"
                }
            },
            "provisional_scot": {
                "path": "provisional_added.csv",
                "variables": {
                    "la_code": "ca_code",
                    "age": "Age",
                    "sex": "sex",
                    "direction": "dir",
                    "year": "year",
                    "count": "count"
                }
            }
        }
    }
}